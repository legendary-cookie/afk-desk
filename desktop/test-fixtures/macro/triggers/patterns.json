    { "pattern": "{who} joined the game", "mode": "glob", "text": " joined the game", "match": null },
    { "pattern": "<{p}> !{cmd} {arg}", "mode": "glob", "text": "<Bob> !tp home now", "match": { "p": "Bob", "cmd": "tp", "arg": "home now" } },
