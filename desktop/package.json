{
  "name": "afkdesk",
  "version": "0.10.0-beta.9",
  "description": "A simple, local-first Minecraft AFK desktop client",
  "main": "electron/main.cjs",
  "author": "AFK Desk contributors",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win nsis",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "bedrock-protocol": "^3.58.3",
    "minecraft-protocol-forge": "github:PrismarineJS/node-minecraft-protocol-forge#54fc6a2f",
    "mineflayer": "4.37.1",
    "mineflayer-pathfinder": "^2.4.5",
    "socks": "^2.8.9"
  },
  "overrides": {
    "tar": "7.5.22",
    "axios": "1.19.0",
    "@azure/msal-node": {
      "uuid": "11.1.1"
    },
    "yggdrasil": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12",
    "patch-package": "8.0.1"
  },
  "build": {
    "appId": "dev.afkdesk.app",
    "productName": "AFK Desk",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/afk-desk.ico",
      "artifactName": "AFK-Desk-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
